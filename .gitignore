# Rojas Stack: WordPress Theme Blueprint .gitignore

# Dependencies
vendor/
node_modules/
.bun/
package-lock.json

# Build Assets
dist/
.vite/
manifest.json

# WordPress Core & Local Environment
conductor/
wp-config.php
wp-config-ddev.php
.ddev/db_snapshots/
.ddev/.importdb*
# Comandos personalizados de DDEV (si se crean)
.ddev/commands/web/bun

# Environment & Secrets
.env
.env.local
.env.*.local

# OS & Editors
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs & Temporary files
*.log
.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.stylelintcache
.phpunit.result.cache

# Playwright
test-results/
playwright-report/
blob-report/
playwright/.cache/

# Agent skills: la fuente vive en .agents/ + skills-lock.json;
# las copias derivadas se regeneran con `skilld prepare`
.skilld
.claude/skills/
.continue/skills/
.gemini/skills/
