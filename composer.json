{
    "name": "cristian-rojas/wp-modern-theme-blueprint",
    "description": "Rojas Stack: Modern Theme Architecture for WordPress (AI-First)",
    "type": "wordpress-theme",
    "license": "MIT",
    "authors": [
        {
            "name": "Cristian Rojas",
            "email": "cristian@example.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "htmlburger/carbon-fields": "*",
        "illuminate/http": "*",
        "jgrossi/corcel": "*",
        "kucrut/vite-for-wp": "^0.12.0",
        "nesbot/carbon": "*",
        "rakit/validation": "*",
        "resend/resend-php": "*",
        "spatie/schema-org": "*",
        "timber/timber": "*",
        "vlucas/phpdotenv": "*"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "deployer/deployer": "*",
        "lucatume/wp-browser": "*",
        "pestphp/pest": "^3.8",
        "php-stubs/wordpress-stubs": "^7.1",
        "phpstan/phpstan": "*",
        "spatie/ignition": "*"
    },
    "autoload": {
        "psr-4": {
            "RojasStack\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "scripts": {
        "analyze": "phpstan analyse --no-progress",
        "lint": "phpstan analyse --no-progress",
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
