{
    "name": "cristian-rojas/wp-modern-theme-blueprint",
    "description": "Rojas Stack: Modern Theme Architecture for WordPress (AI-First)",
    "type": "wordpress-theme",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Cristian Rojas",
            "email": "cristian@example.com"
        }
    ],
    "require": {
        "php": ">=8.5",
        "htmlburger/carbon-fields": "^3.6",
        "illuminate/http": "^13.31",
        "kucrut/vite-for-wp": "^0.12.0",
        "nesbot/carbon": "^3.13",
        "rakit/validation": "^1.4",
        "resend/resend-php": "^1.13",
        "spatie/schema-org": "^5.0",
        "timber/timber": "^2.5",
        "vlucas/phpdotenv": "^5.7"
    },
    "require-dev": {
        "brain/monkey": "^2.7",
        "deployer/deployer": "^8.0",
        "pestphp/pest": "^5.1",
        "php-stubs/wordpress-stubs": "^7.1",
        "phpstan/phpstan": "^2.2",
        "spatie/ignition": "^1.16"
    },
    "autoload": {
        "psr-4": {
            "RojasStack\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "scripts": {
        "analyze": "phpstan analyse --no-progress",
        "lint": "phpstan analyse --no-progress",
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "composer/installers": true,
            "pestphp/pest-plugin": true
        },
        "optimize-autoloader": true,
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
