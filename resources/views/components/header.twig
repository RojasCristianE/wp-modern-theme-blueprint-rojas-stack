{#
  Header del sitio (layout — no es componente de propósito general).

  - Menú programático (MenuServiceProvider) en desktop.
  - Menú móvil: patrón swap daisyUI (bars-3 ↔ x-mark, swap-rotate) con el
    estado en Alpine (swap-active por :class — la variante JS sancionada por
    daisyUI). El panel vive en el flujo del header (sin overlays), se abre
    bajo md y comparte el scope `open` del <header>.
  - El trigger de búsqueda del panel móvil despacha el evento `open-search`
    que components/search-modal.twig escucha en window — un solo modal
    teleportado, nunca dos.
#}
<header x-data="{ open: false }"
        @keydown.window.escape="open = false"
        class="sticky top-0 z-50 w-full bg-surface/80 backdrop-blur-md border-b border-line">
    <!-- DEBUG: Header Loaded -->
    <nav class="container mx-auto px-4 h-20 flex items-center justify-between">
        <!-- Logo -->
        <a href="{{ site.url }}" class="flex items-center gap-2 group">
            <div class="w-10 h-10 bg-brand-600 rounded-lg flex items-center justify-center text-white shadow-lg group-hover:bg-brand-700 transition-colors">
                <span class="font-bold text-xl leading-none">R</span>
            </div>
            <span class="text-xl font-bold tracking-tight text-ink">
                {{ site.title }}
            </span>
        </a>

        <!-- Desktop Menu -->
        <div class="hidden md:flex items-center gap-6">
            <ul class="flex items-center gap-6">
                {% for item in menu.items %}
                    <li>
                        <a href="{{ item.link }}"
                           class="text-sm font-medium text-ink-muted hover:text-brand-600 transition-colors {{ item.current ? 'text-brand-600' : '' }}">
                            {{ item.title }}
                        </a>
                    </li>
                {% endfor %}
            </ul>

            <div class="h-6 w-px bg-line"></div>

            {% include 'components/search-modal.twig' %}

            <a href="#" class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-surface bg-ink rounded-full hover:opacity-90 transition-[opacity,transform] shadow-md active:scale-95">
                Comenzar
            </a>
        </div>

        <!-- Mobile Menu Button: swap daisyUI (bars-3 ↔ x-mark) -->
        <button type="button"
                @click="open = !open"
                class="swap swap-rotate md:hidden p-2 text-ink-muted hover:bg-brand-600/10 rounded-lg transition-colors"
                :class="open && 'swap-active'"
                :aria-expanded="open"
                aria-controls="mobile-nav">
            {% include 'components/icon.twig' with { name: 'x-mark', classes: 'w-6 h-6 swap-on' } only %}
            {% include 'components/icon.twig' with { name: 'bars-3', classes: 'w-6 h-6 swap-off' } only %}
            <span class="sr-only">Menú</span>
        </button>
    </nav>

    <!-- Mobile Nav Panel (en flujo, bajo la barra — nada absoluto). x-cloak: sin flash antes de que Alpine inicialice. -->
    <div id="mobile-nav"
         x-cloak
         x-show="open"
         x-transition:enter="transition ease-out duration-200"
         x-transition:enter-start="-translate-y-2 opacity-0"
         x-transition:enter-end="translate-y-0 opacity-100"
         x-transition:leave="transition ease-in duration-150"
         x-transition:leave-start="opacity-100"
         x-transition:leave-end="opacity-0"
         class="md:hidden border-t border-line">
        <nav class="container mx-auto px-4 py-3">
            <ul class="flex flex-col gap-1">
                {% for item in menu.items %}
                    <li>
                        <a href="{{ item.link }}"
                           @click="open = false"
                           class="block px-3 py-2.5 rounded-lg text-sm font-medium text-ink-muted hover:text-brand-600 hover:bg-brand-600/10 transition-colors {{ item.current ? 'text-brand-600 bg-brand-600/10' : '' }}">
                            {{ item.title }}
                        </a>
                    </li>
                {% endfor %}
            </ul>

            <div class="mt-3 pt-3 border-t border-line flex items-center justify-between gap-3">
                <button type="button"
                        @click="open = false; $dispatch('open-search')"
                        class="inline-flex items-center gap-2 px-3 py-2.5 text-sm font-medium text-ink-muted hover:text-brand-600 hover:bg-brand-600/10 rounded-lg transition-colors">
                    {% include 'components/icon.twig' with { name: 'magnifying-glass', classes: 'w-5 h-5' } only %}
                    Buscar
                </button>

                <a href="#"
                   @click="open = false"
                   class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold text-surface bg-ink rounded-full hover:opacity-90 transition-[opacity,transform] shadow-md active:scale-95">
                    Comenzar
                </a>
            </div>
        </nav>
    </div>
</header>
