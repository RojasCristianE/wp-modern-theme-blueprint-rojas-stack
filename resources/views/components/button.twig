{#
  Botón base del Rojas Stack (spec §8.3). Internals: daisyUI (CSS puro).

  Parámetros:
  - label:    Texto del botón (usar embed con block content para contenido rico).
  - variant:  'primary' | 'secondary' | 'ghost'. Default: 'primary'.
  - href:     Si se define renderiza <a>; si no, <button>.
  - type:     Tipo del <button>. Default: 'button'.
  - full:     true → ancho completo (para formularios).
  - disabled: true → estado deshabilitado (attr disabled en <button>,
              aria-disabled + btn-disabled en <a>).
  - classes:  Clases extra para personalización puntual.
#}
{% set variant_classes = {
    'primary': 'btn-primary shadow-lg shadow-brand-200',
    'secondary': 'btn-outline',
    'ghost': 'btn-ghost',
} %}
{% set base_classes = 'btn rounded-full font-semibold' %}
{% set size_classes = full ? 'btn-lg' : '' %}
{% set all_classes = base_classes ~ ' ' ~ size_classes ~ ' ' ~ (variant_classes[variant ?? 'primary'] ?? variant_classes.primary) ~ ' ' ~ (disabled ? 'btn-disabled' : '') ~ ' ' ~ (classes ?? '') %}

{% if href %}
    <a href="{{ href }}" class="{{ all_classes }}" {{ disabled ? 'aria-disabled="true"' }}>{{ label }}</a>
{% else %}
    <button type="{{ type ?? 'button' }}" class="{{ all_classes }}" {{ disabled ? 'disabled' }}>{{ label }}</button>
{% endif %}
