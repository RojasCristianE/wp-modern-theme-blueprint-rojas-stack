{#
  Botón base del Rojas Stack (spec §8.3).

  Parámetros:
  - label:    Texto del botón (usar embed con block content para contenido rico).
  - variant:  'primary' | 'secondary' | 'ghost'. Default: 'primary'.
  - href:     Si se define renderiza <a>; si no, <button>.
  - type:     Tipo del <button>. Default: 'button'.
  - full:     true → ancho completo (para formularios).
  - disabled: true → opacidad + pointer-events none (+ atributo disabled).
  - classes:  Clases extra para personalización puntual.
#}
{% set variant_classes = {
    'primary': 'text-white bg-brand-600 hover:bg-brand-700 shadow-lg shadow-brand-200',
    'secondary': 'text-ink bg-surface border border-line hover:bg-page shadow-sm',
    'ghost': 'text-ink-muted hover:text-brand-600 hover:bg-brand-600/10',
} %}
{% set base_classes = 'inline-flex items-center justify-center gap-2 font-semibold rounded-full transition-all active:scale-95 outline-none focus-visible:ring-2 focus-visible:ring-brand-600 focus-visible:ring-offset-2 focus-visible:ring-offset-page' %}
{% set size_classes = full ? 'w-full px-8 py-4 text-base' : 'px-5 py-2.5 text-sm' %}
{% set all_classes = base_classes ~ ' ' ~ size_classes ~ ' ' ~ (variant_classes[variant ?? 'primary'] ?? variant_classes.primary) ~ ' ' ~ (disabled ? 'opacity-50 pointer-events-none' : '') ~ ' ' ~ (classes ?? '') %}

{% if href %}
    <a href="{{ href }}" class="{{ all_classes }}">{{ label }}</a>
{% else %}
    <button type="{{ type ?? 'button' }}" class="{{ all_classes }}" {{ disabled ? 'disabled' }}>{{ label }}</button>
{% endif %}
