{#
  Tarjeta para blog/portfolio (spec §8.3).

  Parámetros:
  - title:      Título.
  - url:        Enlace del card (título e imagen enlazan aquí).
  - excerpt:    Resumen corto.
  - image:      URL de imagen (opcional).
  - meta:       Fecha/autor u otro metadato (opcional).
  - link_label: Texto del CTA. Default: 'Leer más'.
#}
<article class="bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden hover:shadow-lg transition-shadow flex flex-col">
    {% if image %}
        <a href="{{ url }}" class="block overflow-hidden">
            <img src="{{ image }}" alt="{{ title }}" class="w-full h-48 object-cover hover:scale-105 transition-transform">
        </a>
    {% endif %}

    <div class="p-6 flex flex-col flex-grow">
        {% if meta %}
            <p class="text-xs font-bold uppercase tracking-wider text-brand-600 mb-2">{{ meta }}</p>
        {% endif %}

        <h3 class="text-lg font-bold text-slate-800 leading-snug">
            <a href="{{ url }}" class="hover:text-brand-600 transition-colors">{{ title }}</a>
        </h3>

        {% if excerpt %}
            <p class="mt-2 text-sm text-slate-500 leading-relaxed flex-grow">{{ excerpt }}</p>
        {% endif %}

        <a href="{{ url }}" class="mt-4 text-sm font-semibold text-brand-600 hover:text-brand-700 hover:underline underline-offset-4">{{ link_label ?? 'Leer más' }} →</a>
    </div>
</article>
