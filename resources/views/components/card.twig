{#
  Tarjeta para blog/portfolio (spec §8.3). Internals: daisyUI.

  Parámetros:
  - title:      Título.
  - url:        Enlace del card (título e imagen enlazan aquí).
  - excerpt:    Resumen corto.
  - image:      URL de imagen (opcional).
  - meta:       Fecha/autor u otro metadato (opcional).
  - link_label: Texto del CTA. Default: 'Leer más'.
#}
<article class="card bg-surface border border-line shadow-sm overflow-hidden">
    {% if image %}
        <a href="{{ url }}" class="block overflow-hidden">
            {% include 'components/image.twig' with {
                attachment: image,
                slot: 'card',
                class: 'w-full h-48 object-cover hover:scale-105 transition-transform',
                alt: title,
            } only %}
        </a>
    {% endif %}

    <div class="card-body flex-grow">
        {% if meta %}
            <p class="text-xs font-bold uppercase tracking-wider text-brand-600 mb-2">{{ meta }}</p>
        {% endif %}

        <h3 class="text-lg font-bold text-ink leading-snug">
            <a href="{{ url }}" class="hover:text-brand-600 transition-colors">{{ title }}</a>
        </h3>

        {% if excerpt %}
            <p class="text-sm text-ink-muted leading-relaxed flex-grow">{{ excerpt }}</p>
        {% endif %}

        <a href="{{ url }}" class="link link-primary link-hover text-sm font-semibold">{{ link_label ?? 'Leer más' }} →</a>
    </div>
</article>
