{#
  Input/textarea con label y estado de error (spec §8.3).

  Parámetros:
  - name:        Name del campo (obligatorio; id hereda de aquí).
  - label:       Texto del label.
  - type:        'text' | 'email' | 'textarea'. Default: 'text'.
  - value:       Valor actual (p.ej. old.name tras fallo de validación).
  - placeholder: Placeholder.
  - error:       Mensaje de error (pinta borde rojo + texto debajo).
  - id:          Override del id (default: name).
  - rows:        Filas del textarea. Default: 4.
#}
{% set id = id ?? name %}
{% set type = type ?? 'text' %}
{% set state_classes = error ? 'border-red-500 bg-red-50' : 'border-slate-200' %}
{% set field_classes = 'w-full px-4 py-3 rounded-xl border ' ~ state_classes ~ ' focus:ring-2 focus:ring-brand-600 focus:border-brand-600 transition-all outline-none' %}

<div>
    <label for="{{ id }}" class="block text-sm font-bold text-slate-700 mb-2">{{ label }}</label>

    {% if type == 'textarea' %}
        <textarea name="{{ name }}" id="{{ id }}" rows="{{ rows ?? 4 }}" placeholder="{{ placeholder ?? '' }}" class="{{ field_classes }}">{{ value ?? '' }}</textarea>
    {% else %}
        <input type="{{ type }}" name="{{ name }}" id="{{ id }}" value="{{ value ?? '' }}" placeholder="{{ placeholder ?? '' }}" class="{{ field_classes }}">
    {% endif %}

    {% if error %}
        <p class="mt-2 text-xs font-bold text-red-600 uppercase tracking-tighter">{{ error }}</p>
    {% endif %}
</div>
