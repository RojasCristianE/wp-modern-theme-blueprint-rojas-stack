{#
  Input/textarea con label y estado de error (spec §8.3). Internals: daisyUI.

  Parámetros:
  - name:        Name del campo (obligatorio; id hereda de aquí).
  - label:       Texto del label.
  - type:        'text' | 'email' | 'textarea'. Default: 'text'.
  - value:       Valor actual (p.ej. old.name tras fallo de validación).
  - placeholder: Placeholder.
  - error:       Mensaje de error (pinta borde rojo + texto debajo).
  - id:          Override del id (default: name).
  - rows:        Filas del textarea. Default: 4.
#}
{% set id = id ?? name %}
{% set type = type ?? 'text' %}
{% set state_classes = error ? 'input-error' : '' %}
{% set field_classes = 'w-full ' ~ state_classes %}

<div>
    <label for="{{ id }}" class="block text-sm font-bold text-ink-muted mb-2">{{ label }}</label>

    {% if type == 'textarea' %}
        <textarea name="{{ name }}" id="{{ id }}" rows="{{ rows ?? 4 }}" placeholder="{{ placeholder ?? '' }}" class="textarea {{ field_classes }}">{{ value ?? '' }}</textarea>
    {% else %}
        <input type="{{ type }}" name="{{ name }}" id="{{ id }}" value="{{ value ?? '' }}" placeholder="{{ placeholder ?? '' }}" class="input {{ field_classes }}">
    {% endif %}

    {% if error %}
        <p class="mt-2 text-xs font-bold text-error uppercase tracking-tighter">{{ error }}</p>
    {% endif %}
</div>
