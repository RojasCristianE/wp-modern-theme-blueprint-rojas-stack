{#
  Alerta semántica (success | error | warning | info). Internals: daisyUI
  (alert + alert-soft, colores por rol del tema: success/error/warning/info).

  Uso simple (include):
    {% include 'components/alert.twig' with { variant: 'success', title: '...', message: '...' } %}

  Uso avanzado (embed) para contenido rico:
    {% embed 'components/alert.twig' with { variant: 'success', title: '...' } %}
        {% block content %}...HTML libre...{% endblock %}
    {% endembed %}
#}
{% set variants = {
    'success': { alert: 'alert-success', icon: 'bg-success text-success-content', icon_name: 'check-circle' },
    'error': { alert: 'alert-error', icon: 'bg-error text-error-content', icon_name: 'x-circle' },
    'warning': { alert: 'alert-warning', icon: 'bg-warning text-warning-content', icon_name: 'alert-triangle' },
    'info': { alert: 'alert-info', icon: 'bg-primary text-primary-content', icon_name: 'info' },
} %}
{% set current = variants[variant ?? 'info'] ?? variants.info %}

<div class="alert alert-vertical alert-soft rounded-2xl text-center shadow-sm {{ current.alert }}">
    <div class="w-12 h-12 rounded-full flex items-center justify-center mx-auto mb-4 {{ current.icon }}">
        {% include 'components/icon.twig' with { name: current.icon_name, classes: 'w-6 h-6' } only %}
    </div>

    {% if title %}
        <h3 class="font-bold text-lg mb-1">{{ title }}</h3>
    {% endif %}

    {% block content %}
        <p class="text-sm">{{ message }}</p>
    {% endblock %}
</div>
