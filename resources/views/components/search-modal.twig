<div x-data="{ open: false }" 
     @keydown.window.escape="open = false" 
     @open-search.window="open = true; $nextTick(() => $refs.searchInput.focus())"
     class="relative">
    
    <!-- Botón de apertura (Trigger) -->
    <button @click="open = true; $nextTick(() => $refs.searchInput.focus())" 
            class="p-2 text-ink-muted hover:text-brand-600 hover:bg-brand-600/10 rounded-full transition-all group"
            title="Buscar (Esc)">
        <svg class="w-5 h-5 group-hover:scale-110 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
        </svg>
    </button>

    <!-- Modal Overlay -->
    <template x-teleport="body">
        <div x-show="open" 
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 z-[100] flex items-start justify-center pt-20 px-4 bg-ink/40 backdrop-blur-sm"
             @click.self="open = false">
            
            <!-- Modal Content -->
            <div x-show="open"
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 translate-y-[-20px] scale-95"
                 x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                 class="w-full max-w-2xl bg-surface rounded-2xl shadow-2xl overflow-hidden border border-line">
                
                <!-- Search Input -->
                <div class="relative p-4 border-b border-line">
                    <div class="absolute inset-y-0 left-6 flex items-center pointer-events-none text-ink-faint">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
                    </div>
                    <input x-ref="searchInput"
                           type="text" 
                           name="s"
                           placeholder="Escribe para buscar..."
                           class="w-full pl-12 pr-4 py-3 text-lg font-medium text-ink placeholder-ink-faint border-none focus:ring-0"
                           hx-get="{{ site.url }}"
                           hx-trigger="keyup changed delay:300ms"
                           hx-target="#search-results"
                           hx-indicator="#search-loading"
                           @focus="htmx.process($el)">
                    
                    <div id="search-loading" class="htmx-indicator absolute right-6 top-1/2 -translate-y-1/2">
                        <div class="animate-spin rounded-full h-5 w-5 border-2 border-brand-600 border-t-transparent"></div>
                    </div>
                </div>

                <!-- Results Area -->
                <div id="search-results" class="bg-surface min-h-[100px]">
                    <div class="p-8 text-center text-ink-faint">
                        Empieza a escribir para ver resultados...
                    </div>
                </div>

                <!-- Footer -->
                <div class="px-4 py-2 bg-page border-t border-line flex justify-between items-center">
                    <span class="text-[10px] font-bold text-ink-faint uppercase tracking-widest">Poder de HTMX + Timber</span>
                    <button @click="open = false" class="text-xs font-semibold text-ink-muted hover:text-ink">Cerrar (Esc)</button>
                </div>
            </div>
        </div>
    </template>
</div>
