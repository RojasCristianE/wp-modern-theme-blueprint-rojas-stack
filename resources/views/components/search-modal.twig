<div x-data="{ open: false }"
     @keydown.window.escape="open = false"
     @open-search.window="open = true; $nextTick(() => $refs.searchInput.focus())"
     class="relative">

    <!-- Botón de apertura (Trigger) -->
    <button @click="open = true; $nextTick(() => $refs.searchInput.focus())"
            class="p-2 text-ink-muted hover:text-brand-600 hover:bg-brand-600/10 rounded-full transition-all group"
            title="Buscar (Esc)">
        {% include 'components/icon.twig' with { name: 'search', classes: 'w-5 h-5 group-hover:scale-110 transition-transform' } only %}
        <span class="sr-only">Buscar</span>
    </button>

    <!-- Modal Overlay -->
    <template x-teleport="body">
        <div x-show="open"
             x-transition:enter="transition ease-out duration-300"
             x-transition:enter-start="opacity-0"
             x-transition:enter-end="opacity-100"
             x-transition:leave="transition ease-in duration-200"
             x-transition:leave-start="opacity-100"
             x-transition:leave-end="opacity-0"
             class="fixed inset-0 z-[100] flex items-start justify-center pt-20 px-4 bg-ink/40 backdrop-blur-sm"
             @click.self="open = false">

            <!-- Modal Content -->
            <div x-show="open"
                 x-transition:enter="transition ease-out duration-300"
                 x-transition:enter-start="opacity-0 translate-y-[-20px] scale-95"
                 x-transition:enter-end="opacity-100 translate-y-0 scale-100"
                 class="w-full max-w-2xl bg-surface rounded-2xl shadow-2xl overflow-hidden border border-line">

                <!-- Search Input -->
                <div class="relative p-4 border-b border-line">
                    <div class="absolute inset-y-0 left-6 flex items-center pointer-events-none text-ink-faint">
                        {% include 'components/icon.twig' with { name: 'search', classes: 'w-5 h-5' } only %}
                    </div>

                    {#
                      Doble comportamiento (contrato de fragmentos + fallback):
                        - HTMX: input delay:300ms → admin-ajax?action=rs_live_search
                          devuelve SOLO partials/search-results.twig → hx-swap interno.
                        - Sin HTMX (Enter): submit nativo del form a /?s=term,
                          que la jerarquía resuelve con search.twig (página completa).
                    #}
                    <form role="search" method="get"
                          action="{{ site.url }}/"
                          hx-get="{{ site.url }}/wp-admin/admin-ajax.php?action=rs_live_search"
                          hx-trigger="input changed delay:300ms from:find input[name='s']"
                          hx-target="#search-results"
                          hx-indicator="#search-results">
                        <input x-ref="searchInput"
                               type="text"
                               name="s"
                               placeholder="Escribe para buscar..."
                               class="w-full pl-12 pr-4 py-3 text-lg font-medium text-ink placeholder-ink-faint border-none focus:ring-0"
                               @focus="htmx.process($el.closest('form'))">
                    </form>
                </div>

                <!-- Results Area (el fragmento reemplaza solo este nodo).
                     Mientras el fetch vuela, HTMX añade `htmx-request` aquí:
                     el skeleton de filas reemplaza al placeholder EN FLUJO
                     (mismo mecanismo in-flow que archive-shell, sin overlay). -->
                <div id="search-results" class="bg-surface min-h-[100px]">
                    <div class="rs-search-placeholder p-8 text-center text-ink-faint">
                        Empieza a escribir para ver resultados...
                    </div>

                    {# Skeleton en flujo: filas gemelas de las filas reales
                       (thumb 48px + dos líneas), visible solo con htmx-request #}
                    <div id="search-skeleton" aria-hidden="true" role="presentation">
                        {% for i in 1..6 %}
                            <div class="flex items-center gap-4 p-4 border-b border-line last:border-b-0">
                                <div class="rs-skeleton w-12 h-12 rounded-lg shrink-0"></div>
                                <div class="min-w-0 flex-1 space-y-2 py-1">
                                    <div class="rs-skeleton h-3.5 w-2/3 rounded"></div>
                                    <div class="rs-skeleton h-3 w-5/6 rounded"></div>
                                </div>
                                <div class="rs-skeleton w-4 h-4 rounded shrink-0"></div>
                            </div>
                        {% endfor %}
                    </div>
                </div>

                <!-- Footer -->
                <div class="px-4 py-2 bg-page border-t border-line flex justify-between items-center">
                    <span class="text-[10px] font-bold text-ink-faint uppercase tracking-widest">Poder de HTMX + Timber</span>
                    <button @click="open = false" class="text-xs font-semibold text-ink-muted hover:text-ink">Cerrar (Esc)</button>
                </div>
            </div>
        </div>
    </template>
</div>
