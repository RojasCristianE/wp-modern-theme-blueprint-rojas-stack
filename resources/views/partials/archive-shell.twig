{#
  Shell del grid de archives: scope Alpine + skeleton en flujo normal.

  Envuelve a partials/archive-grid.twig (el nodo swappeable). El shell
  NO se swappea: sobrevive a cada página. Durante el fetch de HTMX el
  skeleton REEMPLAZA al grid real en el flujo del documento (x-show
  mutuamente excluyentes — sin position:absolute, sin solapamientos con
  paginación ni footer); al llegar el swap, el grid real vuelve y el
  flash de entrada lo maneja archiveView (main.js).

  Parámetros:
  - posts:            PostQuery de Timber (con .pagination).
  - cards:            Cantidad de tarjetas skeleton (default 6 —
                      coincide con POSTS_PER_PAGE default).
  - archive_taxonomy: taxonomy del término paginado (para HTMX).
  - archive_term:     slug del término; '' = home del blog.
  - htmx_endpoint:    URL absoluta de admin-ajax.
  - htmx_base:        URL bonita del archive (para hx-push-url).
#}
{% set cards = cards|default(6) %}
{% set shell_id = 'archive-shell-' ~ random(100000, 999999) %}

<div x-data="archiveView" data-archive-shell id="{{ shell_id }}" class="w-full">
    {# Skeleton en flujo normal: visible SOLO mientras el fetch vuela #}
    <div x-cloak x-show="requestCount > 0" aria-hidden="true"
         class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {% for i in 1..cards %}
            {# Sin placeholder de imagen: el card real no lleva thumbnail #}
            <div class="bg-surface rounded-2xl border border-line shadow-sm p-6 flex flex-col">
                <div class="rs-skeleton h-3 w-24 rounded"></div>
                <div class="rs-skeleton h-5 w-3/4 rounded mt-3"></div>
                <div class="rs-skeleton h-3 w-full rounded mt-2"></div>
                <div class="rs-skeleton h-3 w-5/6 rounded"></div>
                <div class="rs-skeleton h-3 w-20 rounded mt-4"></div>
            </div>
        {% endfor %}
    </div>

    {# Sin x-cloak: visible desde el render inicial (antes de Alpine) #}
    <div x-show="requestCount === 0">
        {% include 'partials/archive-grid.twig' with {
            posts: posts,
            htmx_enabled: true,
            archive_taxonomy: archive_taxonomy|default('category'),
            archive_term: archive_term|default(''),
            htmx_endpoint: htmx_endpoint|default('/wp-admin/admin-ajax.php'),
            htmx_base: htmx_base|default(''),
        } only %}
    </div>
</div>
