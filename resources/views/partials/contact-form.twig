<div id="contact-form-wrapper" class="w-full max-w-lg mx-auto bg-surface p-8 rounded-3xl border border-line shadow-xl">
    <form hx-post="{{ site.url }}/wp-admin/admin-ajax.php?action=submit_contact"
          hx-target="#contact-form-wrapper"
          hx-swap="outerHTML"
          class="space-y-6">

        <input type="hidden" name="action" value="submit_contact">

        {% include 'components/input.twig' with {
            name: 'name',
            label: 'Nombre Completo',
            value: old.name ?? '',
            error: errors.name ?? null,
            placeholder: 'Ej. Juan Pérez',
        } only %}

        {% include 'components/input.twig' with {
            name: 'email',
            type: 'email',
            label: 'Correo Electrónico',
            value: old.email ?? '',
            error: errors.email ?? null,
            placeholder: 'hola@tuempresa.com',
        } only %}

        {% include 'components/input.twig' with {
            name: 'message',
            type: 'textarea',
            label: 'Tu Mensaje',
            value: old.message ?? '',
            error: errors.message ?? null,
            placeholder: '¿Cómo podemos ayudarte?',
        } only %}

        <button type="submit"
                class="w-full inline-flex items-center justify-center px-8 py-4 text-base font-bold text-white bg-brand-600 rounded-full hover:bg-brand-700 transition-all shadow-lg shadow-brand-200 active:scale-95 group">
            <span>Enviar Mensaje</span>
            <div class="htmx-indicator ml-3">
                {{ rs_icon('spinner:180-ring', { class: 'h-5 w-5 text-white' }) }}
            </div>
            {{ rs_icon('arrow-right', { class: 'w-5 h-5 ml-2 group-hover:translate-x-1 transition-transform htmx-indicator-hide' }) }}
        </button>
    </form>
</div>

<style>
    .htmx-request .htmx-indicator-hide { display: none; }
</style>
