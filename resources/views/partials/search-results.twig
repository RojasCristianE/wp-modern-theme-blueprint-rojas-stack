{#
  Fragmento de resultados de búsqueda (spec §9.3).

  Lo solicita HTMX vía admin-ajax?action=rs_live_search&s=… y lo reemplaza
  en #search-results del modal (hx-swap). Tres estados:
    - '' sin término          → mensaje "empieza a escribir"
    - posts vacíos            → "no encontramos resultados"
    - posts                   → lista enlazada

  Consumido por SearchController::render_fragment() (nada más).
#}
{% set search_query = search_query ?? '' %}

{% if search_query == '' %}
    <div class="p-8 text-center text-ink-faint">
        Empieza a escribir para ver resultados...
    </div>
{% elseif posts|length == 0 %}
    <div class="p-12 text-center">
        <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-brand-600/10 text-brand-600 mb-4">
            {% include 'components/icon.twig' with { name: 'magnifying-glass', classes: 'w-6 h-6' } only %}
        </div>
        <p class="text-ink-muted font-medium">
            No encontramos resultados para "{{ search_query }}"
        </p>
    </div>
{% else %}
    <ul class="divide-y divide-line" role="list">
        {% for post in posts %}
            <li>
                <a href="{{ post.link }}"
                   class="flex items-center gap-4 p-4 hover:bg-brand-600/5 transition-colors group">
                    {% if post.thumbnail %}
                        {% include 'components/image.twig' with {
                            attachment: post.thumbnail,
                            slot: 'thumb',
                            class: 'w-12 h-12 rounded-lg object-cover shadow-sm',
                            alt: post.title,
                        } only %}
                    {% else %}
                        <div class="w-12 h-12 rounded-lg bg-brand-600/10 flex items-center justify-center text-brand-600 shrink-0">
                            {% include 'components/icon.twig' with { name: 'document-text', classes: 'w-5 h-5' } only %}
                        </div>
                    {% endif %}

                    <div class="min-w-0">
                        <h4 class="text-sm font-bold text-ink group-hover:text-brand-600 transition-colors truncate">
                            {{ post.title }}
                        </h4>
                        <p class="text-xs text-ink-muted line-clamp-1">
                            {{ post.preview.length(15) }}
                        </p>
                    </div>

                    {% include 'components/icon.twig' with { name: 'arrow-right', classes: 'w-4 h-4 ml-auto text-ink-faint group-hover:text-brand-600 transition-colors' } only %}
                </a>
            </li>
        {% endfor %}
    </ul>
{% endif %}
