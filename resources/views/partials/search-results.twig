<div id="search-results-container" class="mt-4 max-h-[60vh] overflow-y-auto divide-y divide-slate-100">
    {% if posts|length > 0 %}
        {% for post in posts %}
            <a href="{{ post.link }}" class="block p-4 hover:bg-slate-50 transition-colors group">
                <div class="flex items-center gap-4">
                    {% if post.thumbnail %}
                        <img src="{{ post.thumbnail.src|resize(100, 100) }}" class="w-12 h-12 rounded-lg object-cover shadow-sm">
                    {% else %}
                        <div class="w-12 h-12 rounded-lg bg-brand-100 flex items-center justify-center text-brand-600">
                            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 20l-7-7m0 0l-7-7m7 7V3"></path></svg>
                        </div>
                    {% endif %}
                    <div>
                        <h4 class="text-sm font-bold text-slate-800 group-hover:text-brand-600 transition-colors">
                            {{ post.title }}
                        </h4>
                        <p class="text-xs text-slate-500 line-clamp-1">
                            {{ post.preview.length(15) }}
                        </p>
                    </div>
                </div>
            </a>
        {% endfor %}
    {% else %}
        <div class="p-12 text-center">
            <div class="inline-flex items-center justify-center w-12 h-12 rounded-full bg-slate-100 text-slate-400 mb-4">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </div>
            <p class="text-slate-500 font-medium">No encontramos resultados para "{{ search_query }}"</p>
        </div>
    {% endif %}
</div>
