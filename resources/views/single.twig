{% extends "base.twig" %}

{% block content %}
<article class="py-20 lg:py-28 bg-surface">
    <div class="container mx-auto px-4 max-w-4xl">
        
        <!-- Header del Post -->
        <header class="mb-12 text-center">
            {% if post.categories %}
                <div class="mb-4 flex justify-center gap-2">
                    {% for category in post.categories %}
                        <a href="{{ category.link }}" class="text-xs font-bold uppercase tracking-widest text-brand-600 bg-brand-600/10 px-3 py-1 rounded-full">
                            {{ category.name }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}

            <h1 class="text-4xl md:text-5xl lg:text-6xl font-extrabold text-ink tracking-tight mb-6">
                {{ post.title }}
            </h1>

            <div class="flex items-center justify-center gap-4 text-ink-muted text-sm font-medium">
                <time datetime="{{ post.date|date('Y-m-d') }}">
                    {{ post.date|date('d M, Y') }}
                </time>
                <span class="w-1 h-1 bg-ink-faint rounded-full"></span>
                <span>Por {{ post.author.name }}</span>
            </div>
        </header>

        <!-- Imagen Destacada -->
        {% if post.thumbnail %}
            <div class="mb-16 -mx-4 md:mx-0">
                <figure class="aspect-video overflow-hidden rounded-2xl shadow-2xl">
                    {% include 'components/image.twig' with {
                        attachment: post.thumbnail,
                        slot: 'hero',
                        class: 'w-full h-full object-cover transition-transform duration-700 hover:scale-105',
                        alt: post.title,
                    } only %}
                </figure>
                {% if post.thumbnail.caption %}
                    <figcaption class="mt-3 text-center text-sm text-ink-faint italic">
                        {{ post.thumbnail.caption }}
                    </figcaption>
                {% endif %}
            </div>
        {% endif %}

        <!-- Contenido del Post -->
        <div class="prose prose-lg max-w-none dark:prose-invert 
                    prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-ink
                    prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline
                    prose-img:rounded-xl prose-img:shadow-lg
                    prose-strong:text-ink prose-blockquote:border-l-brand-600">
            {{ post.content }}
        </div>

        <!-- Footer del Post -->
        <footer class="mt-20 pt-10 border-t border-line">
            {% if post.tags %}
                <div class="flex flex-wrap gap-2 mb-10">
                    <span class="text-sm font-semibold text-ink-faint mr-2 self-center">Etiquetas:</span>
                    {% for tag in post.tags %}
                        <a href="{{ tag.link }}" class="text-xs font-medium text-ink-muted bg-page px-3 py-1.5 rounded-lg hover:bg-brand-600 hover:text-white transition-colors">
                            #{{ tag.name }}
                        </a>
                    {% endfor %}
                </div>
            {% endif %}

            <!-- Navegación entre posts -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {% if post.prev %}
                    <a href="{{ post.prev.link }}" class="group p-6 rounded-2xl border border-line hover:border-brand-600/30 hover:bg-brand-600/5 transition-[border-color,background-color] text-left">
                        <span class="text-xs font-bold text-ink-faint uppercase tracking-widest block mb-2">Anterior</span>
                        <span class="text-lg font-bold text-ink group-hover:text-brand-600 transition-colors leading-tight">
                            {{ post.prev.title }}
                        </span>
                    </a>
                {% endif %}

                {% if post.next %}
                    <a href="{{ post.next.link }}" class="group p-6 rounded-2xl border border-line hover:border-brand-600/30 hover:bg-brand-600/5 transition-[border-color,background-color] text-right ml-auto">
                        <span class="text-xs font-bold text-ink-faint uppercase tracking-widest block mb-2">Siguiente</span>
                        <span class="text-lg font-bold text-ink group-hover:text-brand-600 transition-colors leading-tight">
                            {{ post.next.title }}
                        </span>
                    </a>
                {% endif %}
            </div>
        </footer>

    </div>
</article>
{% endblock %}
