{% extends "base.twig" %}

{% block content %}
<section class="py-20 lg:py-32 bg-page">
    <div class="container mx-auto px-4">
        
        <div class="max-w-2xl mx-auto text-center mb-16">
            <h1 class="text-4xl font-extrabold tracking-tight text-ink sm:text-5xl mb-6">
                {{ title }}
            </h1>
            <p class="text-lg text-ink-muted">
                Esta página no existe en la base de datos de WordPress. 
                Es una <strong>Ruta Virtual</strong> generada 100% por código en el Rojas Stack.
            </p>
        </div>

        {% include 'partials/contact-form.twig' %}

        <div class="mt-20 grid grid-cols-1 md:grid-cols-3 gap-8 max-w-4xl mx-auto">
            <div class="bg-surface p-6 rounded-2xl border border-line shadow-sm text-center">
                <div class="w-10 h-10 bg-brand-600/10 text-brand-600 rounded-lg flex items-center justify-center mx-auto mb-4">
                    {{ rs_icon('envelope', { class: 'w-6 h-6' }) }}
                </div>
                <h3 class="font-bold text-ink">Email</h3>
                <p class="text-sm text-ink-muted mt-1">soporte@rojasstack.com</p>
            </div>
            <div class="bg-surface p-6 rounded-2xl border border-line shadow-sm text-center">
                <div class="w-10 h-10 bg-brand-600/10 text-brand-600 rounded-lg flex items-center justify-center mx-auto mb-4">
                    {{ rs_icon('map-pin', { class: 'w-6 h-6' }) }}
                </div>
                <h3 class="font-bold text-ink">Ubicación</h3>
                <p class="text-sm text-ink-muted mt-1">Managua, Nicaragua (UNI)</p>
            </div>
            <div class="bg-surface p-6 rounded-2xl border border-line shadow-sm text-center">
                <div class="w-10 h-10 bg-brand-600/10 text-brand-600 rounded-lg flex items-center justify-center mx-auto mb-4">
                    {{ rs_icon('clock', { class: 'w-6 h-6' }) }}
                </div>
                <h3 class="font-bold text-ink">Horario</h3>
                <p class="text-sm text-ink-muted mt-1">Lunes - Viernes, 8am - 6pm</p>
            </div>
        </div>

    </div>
</section>
{% endblock %}
