{% extends "base.twig" %}

{% block content %}
<section class="py-16 bg-page">
    <div class="container mx-auto px-4 max-w-5xl">

        <header class="mb-16 text-center">
            <h1 class="text-4xl font-extrabold tracking-tight text-ink mb-4">{{ title }}</h1>
            <p class="text-ink-muted">
                Catálogo de componentes Twig reutilizables (spec §8.3).
                <span class="inline-block ml-2 px-3 py-1 rounded-full text-xs font-bold uppercase tracking-wider bg-amber-500/10 text-amber-700 dark:text-amber-300">Solo desarrollo</span>
            </p>
        </header>

        {# ---------- Botones ---------- #}
        <section class="mb-16 bg-surface p-8 rounded-2xl border border-line">
            <h2 class="text-xl font-bold text-ink mb-6">Botones</h2>
            <div class="flex flex-wrap items-center gap-4">
                {% include 'components/button.twig' with { label: 'Primario', variant: 'primary' } %}
                {% include 'components/button.twig' with { label: 'Secundario', variant: 'secondary' } %}
                {% include 'components/button.twig' with { label: 'Ghost', variant: 'ghost' } %}
                {% include 'components/button.twig' with { label: 'Deshabilitado', variant: 'primary', disabled: true } %}
                {% include 'components/button.twig' with { label: 'Como enlace', variant: 'primary', href: '#' } %}
            </div>
        </section>

        {# ---------- Inputs ---------- #}
        <section class="mb-16 bg-surface p-8 rounded-2xl border border-line">
            <h2 class="text-xl font-bold text-ink mb-6">Inputs</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 max-w-3xl">
                {% include 'components/input.twig' with { name: 'demo_text', label: 'Texto', placeholder: 'Escribe algo...' } %}
                {% include 'components/input.twig' with { name: 'demo_email', label: 'Email', type: 'email', placeholder: 'hola@rojasstack.com' } %}
                {% include 'components/input.twig' with { name: 'demo_error', label: 'Con error', value: 'no-valido', error: 'Este campo no es válido' } %}
                {% include 'components/input.twig' with { name: 'demo_textarea', label: 'Textarea', type: 'textarea', rows: 3, placeholder: 'Mensaje largo...' } %}
            </div>
        </section>

        {# ---------- Alerts ---------- #}
        <section class="mb-16 bg-surface p-8 rounded-2xl border border-line">
            <h2 class="text-xl font-bold text-ink mb-6">Alertas</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {% include 'components/alert.twig' with { variant: 'success', title: 'Éxito', message: 'La operación se completó correctamente.' } %}
                {% include 'components/alert.twig' with { variant: 'error', title: 'Error', message: 'Algo salió mal. Intenta de nuevo.' } %}
                {% include 'components/alert.twig' with { variant: 'warning', title: 'Advertencia', message: 'Revisa los datos antes de continuar.' } %}
                {% include 'components/alert.twig' with { variant: 'info', title: 'Info', message: 'Mensaje informativo sin urgencia.' } %}
            </div>
        </section>

        {# ---------- Cards ---------- #}
        <section class="mb-16 bg-surface p-8 rounded-2xl border border-line">
            <h2 class="text-xl font-bold text-ink mb-6">Cards</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {% include 'components/card.twig' with {
                    title: 'Post sin imagen',
                    url: '#',
                    meta: '7 Septiembre, 2026',
                    excerpt: 'Tarjeta compacta sin imagen: el contenido ocupa todo el espacio.',
                } %}
                {% include 'components/card.twig' with {
                    title: 'Post con imagen',
                    url: '#',
                    meta: 'Blog',
                    excerpt: 'Tarjeta con imagen destacada, meta y excerpt con CTA.',
                    image: 'https://picsum.photos/seed/rojas/640/360',
                    link_label: 'Ver post',
                } %}
            </div>
        </section>

        {# ---------- Badges ---------- #}
        <section class="mb-16 bg-surface p-8 rounded-2xl border border-line">
            <h2 class="text-xl font-bold text-ink mb-6">Badges</h2>
            <div class="flex flex-wrap items-center gap-3">
                {% include 'components/badge.twig' with { label: 'Brand', variant: 'brand' } %}
                {% include 'components/badge.twig' with { label: 'Neutral', variant: 'neutral' } %}
                {% include 'components/badge.twig' with { label: 'Éxito', variant: 'success' } %}
                {% include 'components/badge.twig' with { label: 'Advertencia', variant: 'warning' } %}
                {% include 'components/badge.twig' with { label: 'Error', variant: 'error' } %}
                {% include 'components/badge.twig' with { label: 'Como enlace', variant: 'brand', href: '#' } %}
            </div>
        </section>

        {# ---------- Iconos ---------- #}
        <section class="mb-8 bg-surface p-8 rounded-2xl border border-line">
            <h2 class="text-xl font-bold text-ink mb-6">Iconos</h2>
            <p class="text-sm text-ink-muted mb-4">SVG inline vía <code class="text-xs bg-page px-2 py-0.5 rounded">components/icon.twig</code> / <code class="text-xs bg-page px-2 py-0.5 rounded">rs_icon()</code> — sets sincronizados con <code class="text-xs bg-page px-2 py-0.5 rounded">bin/sync-icons.sh</code> (spec §12.1, entrada 8). Animación CSS embebida con guard de prefers-reduced-motion.</p>
            <div class="grid grid-cols-3 sm:grid-cols-5 gap-4 max-w-2xl">
                {% for entry in [
                    { name: 'search', label: 'search' },
                    { name: 'close', label: 'close' },
                    { name: 'menu', label: 'menu' },
                    { name: 'arrow-right', label: 'arrow-right' },
                    { name: 'calendar', label: 'calendar' },
                    { name: 'info', label: 'info' },
                    { name: 'material:check_circle', label: 'material:check_circle' },
                    { name: 'material:cancel', label: 'material:cancel' },
                    { name: 'material:error', label: 'material:error' },
                    { name: 'mail', label: 'mail' },
                    { name: 'place', label: 'place' },
                    { name: 'schedule', label: 'schedule' },
                    { name: 'spinner:180-ring', label: 'spinner:180-ring' },
                    { name: 'spinner:12-dots-scale-rotate', label: 'spinner:12-dots' },
                ] %}
                    <div class="flex flex-col items-center gap-2 p-4 rounded-xl border border-line bg-page">
                        {% include 'components/icon.twig' with { name: entry.name, classes: 'w-6 h-6 text-ink' } only %}
                        <span class="text-[10px] font-mono text-ink-faint">{{ entry.label }}</span>
                    </div>
                {% endfor %}
            </div>
        </section>

    </div>
</section>
{% endblock %}
