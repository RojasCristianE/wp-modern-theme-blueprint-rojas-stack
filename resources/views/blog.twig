{% extends "base.twig" %}

{% block content %}
{# Obtenemos los campos de Carbon Fields para la página actual #}
{% set hero_title = function('carbon_get_post_meta', post.id, 'hero_title') %}
{% set hero_subtitle = function('carbon_get_post_meta', post.id, 'hero_subtitle') %}
{% set hero_cta_text = function('carbon_get_post_meta', post.id, 'hero_cta_text') %}
{% set hero_cta_url = function('carbon_get_post_meta', post.id, 'hero_cta_url') %}

<!-- Feed de Posts (Demostración de Loop) -->
<section class="py-20 bg-surface">
    <div class="container mx-auto px-4">
        <div class="flex items-end justify-between mb-12">
            <div>
                <h2 class="text-3xl font-bold text-ink tracking-tight">Últimos Posts</h2>
                <p class="text-ink-muted mt-2">Explora las últimas noticias del stack.</p>
            </div>
            <a href="#" class="text-brand-600 font-bold text-sm hover:underline">Ver todos &rarr;</a>
        </div>

        <div class="transition-opacity duration-150" :class="{ 'opacity-50 pointer-events-none': loading }" x-data="archiveView">
            {% include 'partials/archive-grid.twig' with {
                posts: posts,
                htmx_enabled: true,
                archive_taxonomy: 'category',
                archive_term: archive_term|default(''),
                htmx_endpoint: site.url ~ '/wp-admin/admin-ajax.php',
                htmx_base: htmx_base|default(site.url ~ '/blog/'),
            } only %}
        </div>
    </div>
</section>
{% endblock %}
