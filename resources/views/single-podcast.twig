{% extends "base.twig" %}

{% block content %}
<article class="py-20 lg:py-28 bg-surface">
    <div class="container mx-auto px-4 max-w-4xl">

        <header class="mb-12 text-center">
            <a href="{{ function('get_post_type_archive_link', post.post_type) }}"
               class="inline-block text-xs font-bold uppercase tracking-widest text-brand-600 bg-brand-600/10 px-3 py-1 rounded-full mb-6 hover:bg-brand-600/20 transition-colors">
                ← Podcasts
            </a>

            <h1 class="text-4xl md:text-5xl font-extrabold text-ink tracking-tight mb-6">
                {{ post.title }}
            </h1>

            <div class="text-ink-muted text-sm font-medium">
                <time datetime="{{ post.date|date('Y-m-d') }}">{{ post.date|date('d M, Y') }}</time>
            </div>
        </header>

        {% if post.thumbnail %}
            <figure class="mb-16">
                <img src="{{ post.thumbnail.src|resize(1200, 675) }}" alt="{{ post.title }}" class="w-full rounded-2xl shadow-lg">
                {% if post.thumbnail.caption %}
                    <figcaption class="mt-3 text-center text-sm text-ink-faint italic">{{ post.thumbnail.caption }}</figcaption>
                {% endif %}
            </figure>
        {% endif %}

        <div class="prose prose-lg max-w-none dark:prose-invert
                    prose-headings:font-bold prose-headings:tracking-tight prose-headings:text-ink
                    prose-a:text-brand-600 prose-a:no-underline hover:prose-a:underline
                    prose-img:rounded-xl prose-img:shadow-lg
                    prose-strong:text-ink prose-blockquote:border-l-brand-600">
            {{ post.content }}
        </div>

    </div>
</article>
{% endblock %}
