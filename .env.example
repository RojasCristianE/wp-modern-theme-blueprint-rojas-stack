# Rojas Stack — variables de entorno del tema
# Copia a .env (gitignored) y ajusta por entorno. Cargadas por phpdotenv
# desde functions.php (createImmutable: no sobreescribe variables ya definidas).

# Entorno: development habilita Ignition/Clockwork y el catálogo /__components
WP_ENV=development

# Posts por página en TODOS los feeds paginados (blog, categorías,
# etiquetas, fragmento HTMX de archives). Mínimo 1. Default: 6.
POSTS_PER_PAGE=6

# ── Motor de búsqueda (opcional) ─────────────────────────────────
# Meilisearch (typo-tolerance fuzzy). Con MEILI_HOST vacío la búsqueda
# usa la DB nativa. Keys: write key o master key del servidor.
# Local (DDEV): el compose .ddev/docker-compose.meilisearch.yaml levanta
# el motor; dentro de la red DDEV el host es
# http://ddev-<sitename>-meilisearch:7700 (master key: rs-dev-master-key).
MEILI_HOST=
MEILI_API_KEY=
# Kill-switch: 'false' fuerza búsqueda nativa aunque exista MEILI_HOST.
MEILI_ENABLED=true
